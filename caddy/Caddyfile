{
	on_demand_tls {
		ask http://app:8000/api/tls-ask
	}
}

{$DOMAIN} {
	encode gzip
	reverse_proxy app:8000 {
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
	}
}

# Ağıllı ev (Home Assistant)
ha.{$DOMAIN} {
	# Home Assistant etibar edilməyən proksidən X-Forwarded-For görəndə 400 qaytarır — başlığı ötürmürük
	reverse_proxy homeassistant:8123 {
		header_up -X-Forwarded-For
	}
}

# Saytlar: slug.<DOMAIN> və bağlanmış öz domenləri (sertifikat avtomatik)
https:// {
	tls {
		on_demand
	}
	encode gzip
	reverse_proxy app:8000
}
