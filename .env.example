# ===== Server =====
DOMAIN=asistan.pilothayat.az
PUBLIC_URL=https://asistan.pilothayat.az
# Veb panel üçün uzun təsadüfi şifrə (openssl rand -hex 24)
PANEL_TOKEN=

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=          # @BotFather-dan
TELEGRAM_API_ID=             # my.telegram.org → API development tools
TELEGRAM_API_HASH=
TELEGRAM_ALLOWED_USER_IDS=   # boş qalsa, bota ilk /start yazan sahib olur

# ===== Süni intellekt =====
ANTHROPIC_API_KEY=           # console.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5-5

# ===== Səs → mətn =====
STT_PROVIDER=elevenlabs      # elevenlabs | openai | local
STT_LANGUAGE=                # boş = avtomatik; "aze" Azərbaycan, "tur" türk
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
OPENAI_API_KEY=

# ===== Telefon agenti (ElevenLabs) =====
AGENT_TOOL_SECRET=           # openssl rand -hex 24 — ElevenLabs tool header-inə də yazılır
ALLOWED_CALLER_IDS=          # məs: +994501234567 (vergüllə bir neçə nömrə)

# ===== YouTube =====
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=       # scripts/youtube_auth.py ilə alınır
YOUTUBE_DEFAULT_PRIVACY=unlisted   # private | unlisted | public

# ===== Instagram =====
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=      # uzunmüddətli token (60 gün, avtomatik yenilənir)

# ===== Davranış =====
REQUIRE_CONFIRM_PUBLIC=true  # Instagram və public YouTube-dan əvvəl Telegram-da təsdiq istə
REELS_FRAMING=crop           # crop | blur (horizontal videonu bulanıq fonla yerləşdir)
REELS_MAX_SECONDS=60
SUB_FONT=Noto Sans
KEEP_DAYS=14
