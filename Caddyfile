{
	on_demand_tls {
		ask http://app:8000/api/tls-ask
	}
}

{$DOMAIN} {
	encode gzip
	reverse_proxy app:8000 {
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
	}
}

# Saytlar: slug.<DOMAIN> və bağlanmış öz domenləri (sertifikat avtomatik)
https:// {
	tls {
		on_demand
	}
	encode gzip
	reverse_proxy app:8000
}
